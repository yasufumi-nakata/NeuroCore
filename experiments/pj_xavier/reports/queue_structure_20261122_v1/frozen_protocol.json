    "normalization": "Unicode casefold; backslash becomes slash; no file or URL is opened",
    "precedence": [
      "unusable path",
      "uninspected archive or archive volume",
      "video, audio, image or neuroimage payload extension",
      "software or documentation extension",
      "explicit physiological suffix overrides surrounding EEG or MEG directory",
      "conflicting explicit EEG, iEEG or MEG path tokens",
      "explicit modality plus signal, numeric container, sidecar or other suffix",
